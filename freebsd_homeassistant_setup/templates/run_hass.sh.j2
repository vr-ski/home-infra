#!/bin/sh
export PATH="{{ homeassistant_venv }}/bin:$PATH"
export HOME="{{ homeassistant_home }}"
export USER="{{ homeassistant_user }}"
export TURBOJPEG="/usr/local/lib/libturbojpeg.so"
cd {{ homeassistant_home }}
exec {{ homeassistant_venv }}/bin/hass --ignore-os-check --config {{ homeassistant_config }}
